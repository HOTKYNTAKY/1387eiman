# ================================================================
#  فایل تنظیمات ربات فروش فیلترشکن
#  این فایل را به .env کپی کنید:   cp .env.example .env
#  (در اولین اجرای ربات، ویزارد نصب این کار را خودکار انجام می‌دهد)
# ================================================================

# ---------- تنظیمات اصلی (اجباری) ----------

# توکن ربات که از @BotFather دریافت می‌کنید
BOT_TOKEN=

# آیدی عددی مالک ربات (از @userinfobot بگیرید)
# برای چند ادمین، آیدی‌ها را با کاما جدا کنید. اولین آیدی «مالک» است.
ADMIN_ID=

# ---------- زمان و بکاپ ----------

# منطقه زمانی برای بکاپ خودکار و نمایش تاریخ‌ها
TIMEZONE=Asia/Tehran

# ساعت بکاپ خودکار روزانه با فرمت HH:MM (پیش‌فرض: ۰۰:۰۰ نیمه‌شب)
BACKUP_TIME=00:00

# تعداد فایل‌های بکاپی که روی سرور نگه داشته می‌شوند (قدیمی‌ترها حذف می‌شوند)
BACKUP_KEEP=14

# ---------- مسیرها (نسبت به پوشه پروژه) ----------
DB_PATH=data/bot.db
BACKUP_DIR=backups
LOG_DIR=logs

# سطح لاگ: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ---------- شبکه (اختیاری) ----------

# پروکسی برای اتصال ربات به تلگرام (فقط اگر سرور به تلگرام دسترسی ندارد)
# مثال: socks5://127.0.0.1:1080  یا  http://user:pass@1.2.3.4:8080
PROXY_URL=

# بررسی گواهی SSL پنل‌های 3x-ui / Marzban
# اگر پنل شما گواهی معتبر (دامنه + SSL) دارد true بگذارید.
# برای پنل‌هایی که با IP یا گواهی self-signed کار می‌کنند false بماند.
PANEL_VERIFY_SSL=false
