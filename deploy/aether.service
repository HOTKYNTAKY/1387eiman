# AETHER — OPTIONAL systemd unit (alternative to Nginx static hosting).
# Serves the production build via `vite preview` under systemd supervision.
# For maximum performance prefer Nginx (install.sh) or Docker.
#
# Install:
#   sudo useradd --system --home /opt/aether --shell /usr/sbin/nologin aether
#   sudo cp -a . /opt/aether && cd /opt/aether && sudo -u aether npm ci && sudo -u aether npm run build
#   sudo cp deploy/aether.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now aether
# Then point your reverse proxy (Nginx/Caddy) to 127.0.0.1:8080.

[Unit]
Description=AETHER — futuristic luxury website (vite preview)
After=network.target

[Service]
Type=simple
User=aether
Group=aether
WorkingDirectory=/opt/aether
Environment=NODE_ENV=production
Environment=PORT=8080
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
