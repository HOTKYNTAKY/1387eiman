# VORTEXNET shop API — environment (copy to server/.env on the server;
# install.sh does this automatically on first install).
#
# Port for the shop API + admin panel. Admin panel URL:
#   http://YOUR-SERVER-IP:9273
# If you change this, also re-run install.sh so the nginx /api proxy
# port is updated (or edit /etc/nginx/sites-available/aether by hand).
API_PORT=9273

# Directory for orders.json / config.json (created automatically,
# chmod 700 — contains the admin password hash + Pasarguard API key).
# Default: ./data next to server.mjs.
# DATA_DIR=/root/1387eiman/1387eiman/server/data
